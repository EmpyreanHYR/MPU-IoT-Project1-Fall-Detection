FALLGUARD_HOST=127.0.0.1
FALLGUARD_PORT=18080
FALLGUARD_DATA_DIR=/var/lib/fallguard-cloud
FALLGUARD_INGEST_TOKEN=REPLACE_WITH_CLOUD_TOKEN
FALLGUARD_DASHBOARD_USER=presenter
FALLGUARD_DASHBOARD_PASSWORD=REPLACE_WITH_DASHBOARD_PASSWORD
# Set this to the edge's private-network address when using separate hosts.
FALLGUARD_EDGE_RECORDS_URL=http://127.0.0.1:18082
FALLGUARD_EDGE_RECORDS_TOKEN=REPLACE_WITH_EDGE_TOKEN
FALLGUARD_BACKEND_URL=http://127.0.0.1:18080
