[Unit]
Description=FallGuard Offline fall inference
After=network.target

[Service]
Type=simple
User=fallguard
Group=fallguard
WorkingDirectory=/opt/fallguard/deployment/edge
EnvironmentFile=/etc/fallguard/edge.env
ExecStart=/opt/fallguard/.venv/bin/python /opt/fallguard/deployment/edge/edge_runtime.py --source ${FALLGUARD_SOURCE} --backend auto --hef ${FALLGUARD_HEF} --cpu-model ${FALLGUARD_CPU_MODEL} --classifier /opt/fallguard/artifacts/models/masked_bimamba_quality.onnx --database /var/lib/fallguard-edge/edge.sqlite3 --device-id pi5-offline --no-api --log /var/lib/fallguard-edge/runtime.jsonl --status-file /run/fallguard-edge/status.json --preview-file /run/fallguard-edge/preview.jpg
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
StateDirectory=fallguard-edge
RuntimeDirectory=fallguard-edge
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
